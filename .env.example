# Copy to .env and fill in — or let `make phase0` do it for you.
# .env is gitignored and must never be committed.

# eu-north-1 (Stockholm). The `eu.` inference-profile prefix is what keeps requests
# inside EU regions; in-region on-demand is not offered for the two Claude 4.5 models.
AWS_REGION=eu-north-1

# --- Written by `make phase0` ---------------------------------------------------------
# Account id, used only for readability in scripts and reports.
AWS_ACCOUNT_ID=

# Where the budget alarm sends its notifications. You must confirm the subscription email.
BUDGET_ALERT_EMAIL=

# Bedrock Guardrails. Created by `make guardrail`. Leave empty to run without a guardrail.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# --- Prices, read off https://aws.amazon.com/bedrock/pricing/ (region eu-north-1) ------
# USD per 1,000,000 tokens. Until PRICES_AS_OF and both INPUT/OUTPUT pairs are set, no
# cost figure will be printed anywhere: the cost module refuses rather than guesses.
PRICES_AS_OF=
PRICE_HAIKU_INPUT=
PRICE_HAIKU_OUTPUT=
PRICE_SONNET_INPUT=
PRICE_SONNET_OUTPUT=

# Optional third arm: a cheap non-Claude model, for the cost comparison the posting asks
# about. Record its rates and `make compare` will include it; leave them empty and the arm
# is dropped with a note instead of failing the run.
THIRD_MODEL_ID=deepseek.v3.2
PRICE_THIRD_INPUT=
PRICE_THIRD_OUTPUT=

# --- MCP server -----------------------------------------------------------------------
# Required for the HTTP transport; not needed for stdio. Generate with:
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
MCP_BEARER_TOKEN=

# --- Optional overrides --------------------------------------------------------------
# MAX_TOOL_ITERATIONS=6
# TEMPERATURE=0
# MAX_TOKENS=2048
# CHEAP_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# STRONG_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
